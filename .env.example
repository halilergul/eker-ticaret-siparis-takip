# Supabase project URL — https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key
# Dashboard → Project Settings → API → "Publishable key" (yeni format: sb_publishable_...)
# veya "anon" key (legacy JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (admin yetkili, server-only)
# Dashboard → Project Settings → API → "service_role"
# Sadece server-side kod kullanır; client'a SIZMAMALI
SUPABASE_SERVICE_ROLE_KEY=

# Enderyapi B2B (PoC — feature 002)
# scripts/scrape/enderyapi.ts CLI script'i tarafından okunur.
# Sadece lokal makinede; .env.local gitignored.
# Prod scrape ortamı = GitHub Actions (007 sonrası B2B credentials oraya göç ettirildi).
ENDERYAPI_USERNAME=
ENDERYAPI_PASSWORD=

# İkizler Hırdavat B2B (feature 008)
# http://bayi.ikizlerhirdavat.com — DİKKAT: HTTP (HTTPS değil); plaintext credential
# riski kullanıcı tarafından kabul edildi (spec FR-012).
# Prod: GitHub Repo Secrets (IKIZLER_USERNAME, IKIZLER_PASSWORD).
IKIZLER_USERNAME=
IKIZLER_PASSWORD=

# Levent Şimşek Armatür B2B (feature 008)
# https://liste.leventsimsekarmatur.com
# Prod: GitHub Repo Secrets (LEVENTSIMSEK_USERNAME, LEVENTSIMSEK_PASSWORD).
LEVENTSIMSEK_USERNAME=
LEVENTSIMSEK_PASSWORD=

# GitHub workflow_dispatch (feature 007 — Server Action manuel scrape tetikleme)
# Fine-grained PAT — sadece bu repo'ya scoped, izinler: Actions: Read and write
# Yalnızca server runtime (process.env.GITHUB_PAT); client'a SIZMAMALI.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=
